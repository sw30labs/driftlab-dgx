# DriftLab DGX — copy to .env and chmod 600
#   (umask 077; cp -n .env.example .env)

# ---------------------------------------------------------------------------
# Compliance path is fully offline by default (no LLM required).
# Advisory narratives use the shared Desktop vLLM on :8000 when enabled.
# Start with:  ~/Desktop/start-vllm.sh nemotron-super
#           or ~/Desktop/serve-local-llm.sh up nemotron-super
# Catalog:     curl -s http://127.0.0.1:8000/v1/models
# ---------------------------------------------------------------------------

# none | vllm  (omlx is accepted as a legacy alias for vllm)
DRIFTLAB_LLM_PROVIDER=none

# Unprefixed aliases also work when DRIFTLAB_* is unset:
# LLM_PROVIDER=vllm

DRIFTLAB_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Must match an id from GET ${VLLM_BASE_URL}/models when provider=vllm
DRIFTLAB_VLLM_MODEL=Qwen/Qwen3.6-27B-FP8
# vLLM usually ignores auth; the OpenAI client still needs a non-empty key.
DRIFTLAB_VLLM_API_KEY=test
DRIFTLAB_VLLM_TIMEOUT_S=600

# Desktop-wide aliases (read by llm.py if DRIFTLAB_VLLM_* unset):
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
# VLLM_API_KEY=test
# VLLM_TIMEOUT_S=600

# Other catalog recipes (pick one model id that matches the running server):
# DRIFTLAB_VLLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
# DRIFTLAB_VLLM_MODEL=Qwen/Qwen3-Coder-Next-FP8

# ---------------------------------------------------------------------------
# Local store + artifacts (relative paths are fine)
# ---------------------------------------------------------------------------
DRIFTLAB_DATA_DIR=./.driftlab
# DRIFTLAB_REGISTRY=  # default: bundled seed/agents.yaml

# ---------------------------------------------------------------------------
# Optional SMTP digest (monitor run)
# ---------------------------------------------------------------------------
DRIFTLAB_EMAIL__ENABLED=false
# DRIFTLAB_SMTP_HOST=
# DRIFTLAB_SMTP_PORT=587
# DRIFTLAB_SMTP_USER=
# DRIFTLAB_SMTP_PASSWORD=
# DRIFTLAB_EMAIL_TO=
# DRIFTLAB_EMAIL_FROM=
